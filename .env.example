# Optional. Everything works with none of these set.

# Require X-API-Key on /api/* (and ?api_key= on the WebSocket)
DASHBOARD_API_KEY=

# Session login for the dashboard. Generate the hash with:
#   cd backend && python auth_session.py
# Keep the single quotes: the hash contains "$".
DASHBOARD_ADMIN_USER=
DASHBOARD_ADMIN_PASSWORD_HASH=''
DASHBOARD_SESSION_SECRET=
DASHBOARD_COOKIE_SECURE=0

# Alerts on job failures
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Required only by the optional compose files
REDIS_URL=
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
